# Copy to .env (or PORTKEY_API_KEY.env) and fill in. Never commit the real file.
PORTKEY_API_KEY=your-portkey-key-here

# The gateway every model call goes through. The default is correct for
# Portkey; there is no setting for the model, which is fixed at gpt-6-luna.
AI_BASE_URL=https://api.portkey.ai/v1
